# Generate random hex strings; do not use passwords with URL-reserved characters.
POSTGRES_PASSWORD=replace_with_random_hex
SECRET_KEY=replace_with_another_random_hex
APP_VERSION=1.0.0
APP_PORT=8080
# Local-only by default; use 0.0.0.0 only when you intend to expose the app.
BIND_ADDRESS=127.0.0.1
# Set true after HTTPS is configured.
COOKIE_SECURE=false
